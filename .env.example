# Copy to .env, fill in, then: docker compose up -d --build
# .env is gitignored — never commit real secrets.
# Check everything with: docker compose exec renderer bash /app/scripts/verify_setup.sh

# ---- Instagram ---------------------------------------------------------
# Token from your Meta app (docs/SETUP.md Part A). Two flavours work:
#   Instagram Login  -> IG_GRAPH_HOST=graph.instagram.com   (simplest; no Facebook Page)
#   Facebook Login   -> IG_GRAPH_HOST=graph.facebook.com    (needs a linked Page)
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.instagram.com
# Leave as "me" with Instagram Login. With Facebook Login set your Instagram
# business account id (the verifier prints it).
IG_USER_ID=me
IG_HANDLE=@yourhandle
GRAPH_VERSION=v27.0

# ---- Mode --------------------------------------------------------------
# true  = autopilot: posts on schedule with no approval. Needs no public URL.
# false = each post is sent to Telegram with Approve/Skip links first; that
#         needs WEBHOOK_URL to be public (see the tunnel section below).
AUTO_PUBLISH=false

# ---- Script writer (any OpenAI-compatible chat API) ---------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Voiceover for narrated Reels (ElevenLabs) --------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Stock b-roll (Pexels, free) ----------------------------------------
PEXELS_API_KEY=

# ---- Public hosting for rendered videos ---------------------------------
# Instagram downloads each video from a public URL. Cloudinary's free tier
# with an UNSIGNED upload preset is the default.
UPLOADER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ---- Telegram: alerts, receipts and (optionally) approvals --------------
# Strongly recommended even on autopilot: this is how you hear about failures.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- n8n runtime --------------------------------------------------------
GENERIC_TIMEZONE=Australia/Sydney
TZ=Australia/Sydney
# Set once to a long random string (openssl rand -hex 24); never change it.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Only matters when AUTO_PUBLISH=false: the Approve/Skip links point here, so
# it must be reachable from your phone (a Cloudflare Tunnel hostname).
WEBHOOK_URL=http://localhost:5678
# Token for `docker compose --profile tunnel up -d` (review mode only).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Montage renderer (docs/STANDARD.md) ---
# Seconds per shot and music level under the voice (0.25 ~ -12 dB).
CUT=1.3
MUSIC_LEVEL=0.25
# AI signature shots: set when the gpu profile is running ComfyUI (docker compose --profile gpu up -d)
# COMFYUI_URL=http://comfyui:8188
