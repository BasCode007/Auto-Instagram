# Copy to .env and fill in your values, then `docker compose up -d --build`.
# .env is gitignored — never commit real secrets.
#
# Non-secret settings (igUserId, graphVersion, handle) live in the workflow's
# "Set config" node, not here. See docs/SETUP.md for where each value comes from.

# ---- LLM (script + caption generation) ----
OPENAI_API_KEY=sk-your-openai-key

# ---- Voiceover for narrated Reels (ElevenLabs) ----
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-id
# Optional; the render script defaults to eleven_multilingual_v2
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Stock b-roll (Pexels, free) ----
PEXELS_API_KEY=your-pexels-key

# ---- Public hosting for rendered MP4s ----
# Instagram fetches the video from a public URL, so each render is uploaded.
# Default backend is Cloudinary (free tier, using an UNSIGNED upload preset).
UPLOADER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
# Alternative: serve the files yourself from a directory exposed over https.
# UPLOADER=copy
# PUBLIC_DIR=/repo/public
# PUBLIC_BASE_URL=https://your-domain.example

# ---- Instagram Graph API ----
# Long-lived or System User token with instagram_content_publish (docs/SETUP.md Part A).
IG_ACCESS_TOKEN=your-long-lived-token

# ---- Telegram approvals ----
# Chat id that receives the approve/skip prompt (docs/SETUP.md Part C).
# The bot TOKEN goes into an n8n credential in the UI, not here.
TELEGRAM_CHAT_ID=your-chat-id

# ---- n8n runtime ----
GENERIC_TIMEZONE=Australia/Sydney
# Encrypts saved credentials. Set once to a long random string (e.g.
# `openssl rand -hex 24`) and DO NOT change it after saving credentials.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Public base URL n8n uses to build webhook links. The Telegram approve/skip
# buttons call back to this, so in production it must be publicly reachable
# (a real domain or a tunnel). For local-only testing, leave as localhost.
WEBHOOK_URL=http://localhost:5678
